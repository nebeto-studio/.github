{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Nebeto Studio organization-wide Renovate preset (SHA pinning, grouped Cargo/pnpm updates, safe automerge).",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 07:00 on Monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 3,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 07:00 on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Pin all GitHub Actions to full 40-char commit SHAs and group weekly",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Group Rust Cargo non-major updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo-non-major",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Group pnpm / npm non-major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm-non-major",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Pin Docker base images by digest",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    }
  ]
}
